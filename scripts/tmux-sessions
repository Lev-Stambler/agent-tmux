#!/usr/bin/env bash
# tmux-sessions — renders status row 1 and handles its click/jump routing.
#
#   status [current] [width]
#                     the row itself. Wide: a picker button followed by
#                     "1:alpha 2:bravo ..." as pills on a solid band; <current>
#                     sits on the accent pill, the rest on dim pills. Every
#                     entry is a clickable #[range=user|session_N]; the button
#                     is #[range=user|picker].
#                     If <width> is given and the full rail would not fit in it
#                     (a phone over SSH is ~40-55 columns), the row collapses to
#                     a #[range=user|menu] hamburger, an optional attention
#                     badge, and the current session alone. <width> comes from
#                     '#{client_width}' in status-format, which tmux expands
#                     PER CLIENT before running the job -- so a laptop and a
#                     phone attached to the same session at the same time each
#                     get the row that fits them. Omitted => never collapse.
#   menu CLIENT       open the hamburger menu on CLIENT: panes whose agent needs
#                     you, every session, then the window actions and the
#                     project picker.
#   menu-args CLIENT  print the argv `menu` would hand display-menu, one per
#                     line. A menu is a client-side overlay that capture-pane
#                     cannot see, so this is how the contents get tested.
#   jump N [client]   switch <client> (default: current client) to the Nth
#                     session, numbering sessions alphabetically by name
#                     (tmux's native list-sessions order — same as prefix+o).
#   newwin [client]   open a window next to the one <client> is on, in the same
#                     directory. Row 0's "+" button.
#   split lr|tb [client]
#                     split <client>'s pane side by side (lr) or stacked (tb),
#                     in the same directory. Row 0's "│" and "─" buttons.
#   burst [client]    explode <client>'s window: every pane becomes its own
#                     full-screen window, named "<window>", "<window>·2", ...
#                     The layout, the pane order and the active pane are stashed
#                     on the base window as @agent_burst_* so it can be undone.
#   gather [client]   put them back: join every pane of the group into the base
#                     window in its original ORDER, then re-apply the saved
#                     layout (select-layout matches panes to cells positionally,
#                     so the order is what makes it exact).
#   burst-toggle [client]
#                     gather when the current window belongs to a burst group,
#                     burst otherwise. This is the bound key, and it works from
#                     a satellite as well as from the base.
#   click RANGE [client]
#                     MouseDown1Status handler: jumps when RANGE is a
#                     session_N user range, runs the window action for an
#                     agent_* range (row 0's buttons), no-op for anything else.
#
# Colors and the button come from @agent_tmux_* options (see agent-tmux.tmux);
# the defaults below are Catppuccin Mocha so it looks right out of the box.
set -u

# --- palette: one `show-options` fork, defaults when the plugin isn't loaded ---
ACCENT='#cba6f7'     # mauve    — current-session pill
ACCENT_FG='#11111b'  # crust    — text on the accent pill
PILL_BG='#313244'    # surface0 — other-session pills
PILL_FG='#a6adc8'    # subtext0 — text on dim pills
BAND='#181825'       # mantle   — row background between pills
BTN_BG='#313244'     # button pill background
BTN_FG='#cba6f7'     # button glyph
BTN_LABEL='+'        # button glyph; empty or "off" hides the button
MENU_LABEL='☰'       # hamburger glyph shown instead of the rail when narrow
NARROW=''            # force a breakpoint; empty => collapse only when it doesn't fit
S_BLOCKED='#f38ba8'  # badge colour: a pane is blocked
S_WAITING='#f9e2af'  # badge colour: a pane finished its turn
MENU_MAX=16          # hard cap on menu items; 0 = only the client-height cap
                     # (12 sessions + the 4 window actions the tail always adds)

load_opts(){
  local opts
  opts="$(tmux show-options -g 2>/dev/null | grep '^@agent_tmux_' 2>/dev/null)" || return 0
  [ -n "$opts" ] || return 0
  local k v
  while IFS= read -r line; do
    k="${line%% *}"; v="${line#* }"
    v="${v%\"}"; v="${v#\"}"
    [ -n "$v" ] || continue
    case "$k" in
      @agent_tmux_accent)       ACCENT="$v" ;;
      @agent_tmux_accent_fg)    ACCENT_FG="$v" ;;
      @agent_tmux_pill_bg)      PILL_BG="$v" ;;
      @agent_tmux_pill_fg)      PILL_FG="$v" ;;
      @agent_tmux_band)         BAND="$v" ;;
      @agent_tmux_button_bg)    BTN_BG="$v" ;;
      @agent_tmux_button_fg)    BTN_FG="$v" ;;
      @agent_tmux_button_label) BTN_LABEL="$v" ;;
      @agent_tmux_menu_label)   MENU_LABEL="$v" ;;
      @agent_tmux_narrow_width) NARROW="$v" ;;
      @agent_tmux_state_blocked) S_BLOCKED="$v" ;;
      @agent_tmux_state_waiting) S_WAITING="$v" ;;
      @agent_tmux_menu_max)     MENU_MAX="$v" ;;
    esac
  done <<EOF
$opts
EOF
}

sessions(){ tmux list-sessions -F '#{session_name}' 2>/dev/null; }

# What CLIENT is looking at. Everything row 0 does (new window, split) has to
# happen where the person who tapped is, and a backgrounded run-shell carries no
# client of its own -- so the client is passed in explicitly and resolved here.
# Empty when there is no such client: the callers then fall back to tmux's own
# current target rather than doing nothing.
client_fmt(){ # <client> <format>
  local c="${1:-}"
  tmux display-message ${c:+-c "$c"} -p "$2" 2>/dev/null
}

# Recompute one window's agent colour from the panes that are in it NOW.
# @agent_state is a PANE option and travels with the pane; the colour it
# produces is a WINDOW option and does not. Moving panes between windows --
# exactly what burst and gather do -- therefore leaves the window a pane left
# painted with an aggregate it no longer has, and the window it joined painted
# with nothing at all. Verified: break a blocked pane out and the old tab stays
# red while the new one shows no colour.
paint_win(){ # <window>
  local st p
  st="$(cd "$(dirname "$0")" && pwd)/agent-status.sh"
  [ -x "$st" ] || return 0
  p="$(tmux list-panes -t "$1" -F '#{pane_id}' 2>/dev/null | head -1)"
  [ -n "$p" ] && TMUX_PANE="$p" "$st" paint </dev/null >/dev/null 2>&1
  return 0
}

# One `tmux` call per window, not four: each is a fork, and a six-pane explode
# would otherwise pay twenty-four of them on a keystroke.
burst_mark(){ # <window> <group id> <layout> <pane order> <active pane>
  tmux set-option -w -t "$1" @agent_burst_of "$2" \; \
       set-option -w -t "$1" @agent_burst_layout "$3" \; \
       set-option -w -t "$1" @agent_burst_panes "$4" \; \
       set-option -w -t "$1" @agent_burst_active "$5" 2>/dev/null
}
burst_unmark(){ # <window>
  tmux set-option -w -t "$1" -u @agent_burst_of \; \
       set-option -w -t "$1" -u @agent_burst_layout \; \
       set-option -w -t "$1" -u @agent_burst_panes \; \
       set-option -w -t "$1" -u @agent_burst_active \; \
       set-option -w -t "$1" -u @agent_burst_zoom \; \
       set-option -w -t "$1" -u @agent_burst_auto 2>/dev/null
}

# tmux resolves a target that no longer exists to the CURRENT one and still
# exits 0 -- `display-message -t @dead` prints an empty line and succeeds -- so
# "is it still there?" has to be asked of a real list. Measured: without this
# the promote path never fired, because the dead base looked alive.
win_alive(){ # <window id>
  tmux list-windows -a -F '#{window_id}' 2>/dev/null | grep -qx "$1"
}
pane_win(){  # <pane id> -> the window holding it, empty if the pane is gone
  tmux list-panes -a -F '#{pane_id} #{window_id}' 2>/dev/null \
    | awk -v p="$1" '$1==p {print $2}'
}

# Every window of a burst group, base included, in window order.
burst_members(){ # <group id>
  tmux list-windows -a -F '#{window_id} #{@agent_burst_of}' 2>/dev/null \
    | awk -v g="$1" '$2==g {print $1}'
}

# Where does a status-bar range go? One implementation, two callers: `route`
# prints the decision (so tests can assert it without opening a popup that
# blocks forever waiting for a human), `click` acts on it.
route_of(){
  case "${1:-}" in
    menu)   printf 'menu'   ;;
    picker) printf 'picker' ;;
    agent_newwin)   printf 'newwin'   ;;
    agent_split_lr) printf 'split lr' ;;
    agent_split_tb) printf 'split tb' ;;
    session_*)
      n="${1#session_}"
      case "$n" in ''|*[!0-9]*) printf 'none' ;; *) printf 'jump %s' "$n" ;; esac ;;
    *) printf 'none' ;;
  esac
}

case "${1:-}" in
  jump)
    n="${2:-}"; client="${3:-}"
    case "$n" in ''|*[!0-9]*) exit 0 ;; esac
    target="$(sessions | sed -n "${n}p")"
    [ -n "$target" ] || exit 0
    if [ -n "$client" ]; then
      tmux switch-client -c "$client" -t "=$target" 2>/dev/null
    else
      tmux switch-client -t "=$target" 2>/dev/null
    fi
    exit 0
    ;;
  newwin)
    # New window, right after the one the client is on, in the same directory:
    # tmux would otherwise open it at the SESSION's path, which after a day of
    # work is rarely the project you are looking at.
    # -t takes a WINDOW here -- handing new-window a pane id fails outright
    # ("can't specify pane here"), silently, since this runs detached.
    w="$(client_fmt "${2:-}" '#{window_id}')"
    if [ -n "$w" ]; then
      tmux new-window -a -t "$w" -c '#{pane_current_path}'
    else
      tmux new-window
    fi
    exit 0
    ;;
  split)
    # lr -> panes side by side (tmux calls that -h), tb -> stacked (-v).
    # Named for what you SEE, because the buttons are two glyphs with no words.
    case "${2:-lr}" in lr) flag=-h ;; *) flag=-v ;; esac
    p="$(client_fmt "${3:-}" '#{pane_id}')"
    if [ -n "$p" ]; then
      tmux split-window "$flag" -t "$p" -c '#{pane_current_path}'
    else
      tmux split-window "$flag"
    fi
    exit 0
    ;;
  burst)
    # Explode: every pane of the client's window becomes its own full-screen
    # window, named after the original. The layout, the pane ORDER and the pane
    # you were in are stashed on every window of the group so `gather` can undo
    # it exactly. Ids only, never indices -- renumber-windows shifts those the
    # moment any window closes.
    client="${2:-}"
    w="$(client_fmt "$client" '#{window_id}')"
    [ -n "$w" ] || exit 0
    # Never nest a group in a group. burst-toggle routes an exploded window to
    # gather, but `burst` is a subcommand in its own right, and run on a
    # satellite it would re-mark that window as its own base and quietly secede
    # it from the group it belongs to.
    [ -z "$(tmux show-window-options -v -t "$w" @agent_burst_of 2>/dev/null)" ] || exit 0
    n="$(tmux display-message -p -t "$w" '#{window_panes}' 2>/dev/null)"
    case "$n" in ''|*[!0-9]*) exit 0 ;; esac
    if [ "$n" -lt 2 ]; then
      # A toggle that silently does nothing is indistinguishable from a key that
      # is not bound. -c puts the message on the terminal of whoever pressed it.
      tmux display-message ${client:+-c "$client"} -d 1500 \
        "agent-tmux: one pane — nothing to explode" 2>/dev/null
      exit 0
    fi
    # #{window_layout} ignores zoom, so the saved string is right either way --
    # but breaking panes out from under a zoomed one is needless risk.
    zoom="$(tmux display-message -p -t "$w" '#{window_zoomed_flag}' 2>/dev/null)"
    [ "$zoom" = 1 ] && tmux resize-pane -Z -t "$w" 2>/dev/null
    layout="$(tmux display-message -p -t "$w" '#{window_layout}' 2>/dev/null)"
    name="$(tmux display-message -p -t "$w" '#{window_name}' 2>/dev/null)"
    auto="$(tmux show-window-options -v -t "$w" automatic-rename 2>/dev/null)"
    active="$(client_fmt "$client" '#{pane_id}')"
    panes="$(tmux list-panes -t "$w" -F '#{pane_id}' 2>/dev/null | tr '\n' ' ')"
    # The record goes on EVERY member, base included, and the base's
    # @agent_burst_of points at itself. Two things fall out of that: "am I in a
    # group?" is one read that does not care which window you are on, and
    # closing the base does not take the layout with it -- any survivor can
    # still put the rest back.
    burst_mark "$w" "$w" "$layout" "$panes" "$active"
    tmux set-option -w -t "$w" @agent_burst_zoom "${zoom:-0}" 2>/dev/null
    tmux set-option -w -t "$w" @agent_burst_auto "${auto:-on}" 2>/dev/null
    # Pin the base's name too, or a window whose name tracks its process drifts
    # to "node" while its own satellites still read "api·2" and the family stops
    # reading as one. Pin it by turning automatic-rename off, NOT by renaming it
    # to itself: rename-window expands its argument as a format (measured: a
    # window named '#S-hash' comes back 'sess-hash'), so that round trip would
    # destroy any name containing a '#'. break-pane -n does NOT expand -- the
    # two are opposite, which is why the satellite names below are passed
    # through unescaped. @agent_burst_auto puts the option back on collapse.
    tmux set-option -w -t "$w" automatic-rename off 2>/dev/null
    i=1; prev="$w"; first=1
    # shellcheck disable=SC2086 -- $panes is a list of pane ids on purpose
    for p in $panes; do
      # The first pane stays put, so the base window keeps its id, its name and
      # its options -- and we never break the LAST pane out of a window, the one
      # case whose behaviour the man page does not define.
      [ "$first" = 1 ] && { first=0; continue; }
      i=$((i+1))
      # Each break chains off the previous satellite so the tabs read left to
      # right in pane order. -a could not be dated to the 3.2 floor, hence the
      # fallback: without it the window still appears, just at the end.
      nw="$(tmux break-pane -d -a -P -F '#{window_id}' -s "$p" -t "$prev" -n "$name·$i" 2>/dev/null)" \
        || nw="$(tmux break-pane -d -P -F '#{window_id}' -s "$p" -n "$name·$i" 2>/dev/null)"
      [ -n "$nw" ] || continue
      burst_mark "$nw" "$w" "$layout" "$panes" "$active"
      # Without this the running command renames the tab and the ·N is lost.
      tmux set-option -w -t "$nw" automatic-rename off 2>/dev/null
      prev="$nw"
    done
    # Repaint every window of the group: the panes just moved, so both the tab
    # the pane left and the tab it landed on are showing the wrong colour.
    for m in $(burst_members "$w"); do paint_win "$m"; done
    # Land on the pane you were reading, whichever window it now lives in.
    # `focus` and not select-window: it switches the CLIENT's session first, so
    # this still works when the group is spread across sessions.
    [ -n "$active" ] && "$0" focus "$active" "$client"
    "$0" refresh
    exit 0
    ;;
  gather)
    # Collapse: join every pane of the group back into the base window, in the
    # order they were in, then re-apply the saved layout. select-layout matches
    # panes to cells POSITIONALLY -- the pane ids in a layout string are written
    # on dump and never read back -- so rebuilding the order first is the whole
    # trick, and is what makes the restore byte-exact.
    client="${2:-}"
    w="$(client_fmt "$client" '#{window_id}')"
    [ -n "$w" ] || exit 0
    gid="$(tmux show-window-options -v -t "$w" @agent_burst_of 2>/dev/null)"
    [ -n "$gid" ] || exit 0                      # not part of a group: no-op
    # The record is read off the window we are standing on, which is a member by
    # definition and is certainly alive. The base is where the panes go home to
    # -- unless it was closed while the group was open, in which case this
    # window is promoted and takes them instead.
    layout="$(tmux show-window-options -v -t "$w" @agent_burst_layout 2>/dev/null)"
    order="$(tmux show-window-options -v -t "$w" @agent_burst_panes 2>/dev/null)"
    active="$(tmux show-window-options -v -t "$w" @agent_burst_active 2>/dev/null)"
    base="$gid"
    win_alive "$base" || base="$w"               # base closed: this window takes over
    # Panes a satellite gained while it was out on its own come home too, at the
    # end: losing a pane would be far worse than losing the exact layout.
    extra=""
    for sw in $(burst_members "$gid"); do
      for sp in $(tmux list-panes -t "$sw" -F '#{pane_id}' 2>/dev/null); do
        case " $order " in *" $sp "*) ;; *) extra="$extra $sp" ;; esac
      done
    done
    prev="$(tmux list-panes -t "$base" -F '#{pane_id}' 2>/dev/null | tail -1)"
    # shellcheck disable=SC2086 -- both are lists of pane ids on purpose
    for p in $order $extra; do
      pw="$(pane_win "$p")"
      [ -n "$pw" ] || continue                   # that pane closed while exploded
      [ "$pw" = "$base" ] && { prev="$p"; continue; }
      # Joining onto the previously placed pane is what rebuilds the order, but
      # it also halves that pane every time: 22 rows -> 11 -> 5 -> 2 -> no room.
      # The other axis buys a few more, and past that `tiled` redistributes the
      # window without touching its pane ORDER, which is the thing we are here
      # to preserve. Measured: twelve panes lost three without this.
      tmux join-pane -d -v -s "$p" -t "$prev" 2>/dev/null \
        || tmux join-pane -d -h -s "$p" -t "$prev" 2>/dev/null \
        || { tmux select-layout -t "$base" tiled 2>/dev/null
             tmux join-pane -d -v -s "$p" -t "$prev" 2>/dev/null \
               || tmux join-pane -d -h -s "$p" -t "$prev" 2>/dev/null; } \
        || continue
      prev="$p"
    done
    # A satellite that was split further leaves more panes than the layout has
    # cells, and tmux refuses such a layout outright ("have N panes but need M").
    tmux select-layout -t "$base" "$layout" 2>/dev/null \
      || tmux select-layout -t "$base" tiled 2>/dev/null
    # Zoom is not in the layout string, so it is carried separately.
    [ "$(tmux show-window-options -v -t "$base" @agent_burst_zoom 2>/dev/null)" = 1 ] \
      && [ -n "$active" ] && tmux resize-pane -Z -t "$active" 2>/dev/null
    # Give the base's automatic-rename back, and prefer unsetting it to leaving
    # a window-local copy of what the global already says.
    auto="$(tmux show-window-options -v -t "$base" @agent_burst_auto 2>/dev/null)"
    if [ -n "$auto" ]; then
      if [ "$auto" = "$(tmux show-options -gwv automatic-rename 2>/dev/null)" ]; then
        tmux set-option -w -t "$base" -u automatic-rename 2>/dev/null
      else
        tmux set-option -w -t "$base" automatic-rename "$auto" 2>/dev/null
      fi
    fi
    [ -n "$active" ] && "$0" focus "$active" "$client"
    # Anything still holding panes could not be joined -- a window can only be
    # split so many times. Leave the whole group marked in that case, so the key
    # finishes the job on the next press instead of orphaning those panes with
    # no way home.
    left=0
    for m in $(burst_members "$gid"); do
      [ "$m" = "$base" ] && continue
      [ -n "$(tmux list-panes -t "$m" -F '#{pane_id}' 2>/dev/null)" ] && left=$((left+1))
    done
    if [ "$left" -gt 0 ]; then
      tmux display-message ${client:+-c "$client"} -d 2000 \
        "agent-tmux: no room for $left more window(s) — press again after closing a pane" 2>/dev/null
    else
      # The base is in this list too: its @agent_burst_of points at itself.
      for m in $(burst_members "$gid"); do burst_unmark "$m"; paint_win "$m"; done
    fi
    "$0" refresh
    exit 0
    ;;
  burst-toggle)
    # The bound verb. Reading the state off the CURRENT window is what lets the
    # key collapse the group from a satellite as well as from the base -- you
    # press it where you are, not where you started.
    client="${2:-}"
    w="$(client_fmt "$client" '#{window_id}')"
    [ -n "$w" ] || exit 0
    if [ -n "$(tmux show-window-options -v -t "$w" @agent_burst_of 2>/dev/null)" ]; then
      exec "$0" gather "$client"
    fi
    exec "$0" burst "$client"
    ;;
  status)
    current="${2:-}"; width="${3:-}"
    # Resolve the session list FIRST. If the server is unreachable (e.g. inside a
    # sandbox with a fresh /tmp) print nothing at all — a lone picker button on an
    # otherwise empty row is worse than no row.
    list="$(sessions)" || exit 0
    [ -n "$list" ] || exit 0
    load_opts

    # Build the full rail, tracking its RENDERED width as we go so we can tell
    # whether it fits without measuring the styled string (which is full of
    # #[...] directives that occupy no columns).
    #   total = leading space + every segment + one space between segments
    # Widths use the RAW name: '#' is doubled for tmux's benefit but draws as one.
    i=0; out=""; segw=0; nseg=0; cur_i=0; cur_name=""
    case "$BTN_LABEL" in
      ''|off|none) ;;
      *) out="#[range=user|picker]#[fg=${BTN_FG},bg=${BTN_BG},bold] ${BTN_LABEL//#/##} #[norange]#[default]#[bg=${BAND}]"
         segw=$(( segw + ${#BTN_LABEL} + 2 )); nseg=$(( nseg + 1 )) ;;
    esac
    while IFS= read -r name; do
      i=$((i+1))
      # tmux interprets #[...] in what we print, so a session literally named
      # "#[bg=red]" would repaint the row and swallow the pills after it.
      # Doubling '#' makes tmux render it as text. (It cannot reach #() command
      # execution — job output is not re-expanded — but it does wreck the row.)
      disp="${name//#/##}"
      if [ "$name" = "$current" ]; then
        cur_i=$i; cur_name="$name"
        seg="#[range=user|session_${i}]#[fg=$ACCENT_FG,bg=$ACCENT,bold] ${i}:${disp} #[norange]#[default]#[bg=$BAND]"
      else
        seg="#[range=user|session_${i}]#[fg=$PILL_FG,bg=$PILL_BG] ${i}:${disp} #[norange]#[default]#[bg=$BAND]"
      fi
      out="${out:+$out }$seg"
      segw=$(( segw + ${#i} + 1 + ${#name} + 2 )); nseg=$(( nseg + 1 ))
    done <<EOF
$list
EOF
    total=$(( 1 + segw + nseg - 1 ))

    # Does it fit? Only collapse when we were told a width. @agent_tmux_narrow_width
    # forces a fixed breakpoint for people who want one; the default is the honest
    # question "is this actually too wide", which needs no magic number.
    narrow=0
    # @agent_tmux_menu_label off/none disables narrow mode entirely: the rail
    # always renders wide and simply gets clipped, which is what the VHS pixel
    # scenarios need (their sampler assumes a fixed 7 columns per pill).
    case "$MENU_LABEL" in ''|off|none) width='' ;; esac
    case "$width" in
      ''|*[!0-9]*) ;;
      *) if [ -n "$NARROW" ]; then
           case "$NARROW" in *[!0-9]*) ;; *) [ "$width" -lt "$NARROW" ] && narrow=1 ;; esac
         else
           [ "$total" -gt "$width" ] && narrow=1
         fi ;;
    esac

    # Stage the menu for the mouse path. A menu opened from an ASYNC run-shell
    # cannot be operated by mouse at all: display-menu sets MENU_NOMOUSE when the
    # invoking command carries no mouse event, and a NOMOUSE menu ignores every
    # press and closes on every release -- verified, the tap opens nothing. The
    # binding therefore uses `run-shell -C "#{@agent_menu_cmd}"`, which runs a
    # tmux command on the SAME queue item and keeps the mouse event, so the
    # command line has to be sitting in an option ready to go.
    # Deliberately NOT named @agent_tmux_* so load_opts never parses it.
    tmux set-option -g @agent_menu_cmd "$("$0" menu-cmd "" 0 2>/dev/null)" 2>/dev/null

    if [ "$narrow" -eq 0 ]; then
      printf '%s' "$out"
      exit 0
    fi

    # --- narrow: hamburger + attention badge + the current session alone -------
    nout="#[range=user|menu]#[fg=${BTN_FG},bg=${BTN_BG},bold] ${MENU_LABEL//#/##} #[norange]#[default]#[bg=${BAND}]"
    n_block=0; n_wait=0
    while IFS= read -r st; do
      case "$st" in blocked) n_block=$((n_block+1)) ;; waiting) n_wait=$((n_wait+1)) ;; esac
    done <<EOF
$(tmux list-panes -a -F '#{@agent_state}' 2>/dev/null)
EOF
    n_att=$(( n_block + n_wait ))
    if [ "$n_att" -gt 0 ]; then
      # Highest concern wins, same priority as the window tabs: blocked > waiting.
      if [ "$n_block" -gt 0 ]; then bcol="$S_BLOCKED"; else bcol="$S_WAITING"; fi
      # Also a `menu` range: on a phone the badge is the thing you aim at.
      nout="$nout #[range=user|menu]#[fg=${ACCENT_FG},bg=${bcol},bold] ●${n_att} #[norange]#[default]#[bg=${BAND}]"
    fi
    if [ "$cur_i" -gt 0 ]; then
      nout="$nout #[range=user|session_${cur_i}]#[fg=$ACCENT_FG,bg=$ACCENT,bold] ${cur_i}:${cur_name//#/##} #[norange]#[default]#[bg=$BAND]"
    fi
    printf '%s' "$nout"
    ;;
  menu|menu-args|menu-cmd)
    mode="$1"; client="${2:-}"; load_opts
    SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

    # Menu item names AND commands are formats: tmux expands them when the menu
    # is drawn and again when an item is chosen. Two rules follow.
    #  * Any session name reaching a NAME must have '#' doubled, exactly like the
    #    rail -- else a session called '#[bg=red]evil' repaints the menu row.
    #  * No COMMAND ever embeds a name. Sessions are addressed by rail index and
    #    panes by pane id -- digits and '%' only -- so an apostrophe in a name
    #    ("it's") cannot break the quoting: -t '=it's' resolves to "its".
    esc(){ printf '%s' "${1//#/##}"; }
    q(){ local v="${1//\\/\\\\}"; v="${v//\"/\\\"}"; printf '"%s"' "$v"; }
    # Never a two-character key: tmux cannot parse "10" and silently renders the
    # item with NO shortcut, making it unreachable from the keyboard.
    # c, h, v, e, s and p are reserved for the tail entries at the foot of the
    # menu; handing one out twice makes one of the two unreachable.
    LETTERS='qwrtyuiozxbnm'
    mkey(){ case "$1" in [1-9]) printf '%s' "$1" ;; *) printf '%s' "${LETTERS:$(( $1 - 10 )):1}" ;; esac; }

    # A menu taller than the client draws NOTHING at all (max items is about
    # client_height - 2), so cap and offer an overflow entry instead.
    cap="${3:-0}"
    case "$cap" in ''|*[!0-9]*) cap=0 ;; esac
    if [ "$cap" -eq 0 ]; then
      h="$(tmux display-message ${client:+-c "$client"} -p '#{client_height}' 2>/dev/null)"
      case "$h" in ''|*[!0-9]*) h=24 ;; esac
      cap=$(( h - 4 ))
    fi
    [ "$MENU_MAX" -gt 0 ] 2>/dev/null && [ "$cap" -gt "$MENU_MAX" ] && cap="$MENU_MAX"
    # 7, not 5: five of those slots are the always-present tail, and a menu that
    # lists no sessions at all is not worth drawing.
    [ "$cap" -lt 7 ] && cap=7

    # The tail (new window / split right / split down / explode / new project)
    # is always there, so it is counted against the cap from the start --
    # otherwise a short client gets a menu taller than itself, which tmux draws
    # as NOTHING.
    args=(); n=5
    att="$(tmux list-panes -a -F '#{@agent_state}|#{session_name}|#{window_index}|#{pane_index}|#{pane_id}' 2>/dev/null \
           | grep -E '^(blocked|waiting)\|' | sort)"
    if [ -n "$att" ]; then
      args+=( "-needs you" '' '' ); n=$((n+1)); k=0
      while IFS='|' read -r st sess win pane pid; do
        [ -n "${st:-}" ] || continue
        n=$((n+1)); [ "$n" -ge "$cap" ] && break
        k=$((k+1))
        # No #[fg=] here: tmux counts the style bytes toward the item's width and
        # truncates the visible text with a '>'. The !/* marks carry the
        # distinction instead, and they survive a monochrome phone terminal.
        case "$st" in blocked) mark='!' ;; *) mark='*' ;; esac
        args+=( "${mark} $(esc "$sess"):${win}.${pane}  ${st}" \
                "$(mkey $((k+9)))" \
                "run-shell \"$SELF focus '$pid' '#{client_name}'\"" )
      done <<EOF
$att
EOF
      args+=( '' ); n=$((n+1))
    fi

    args+=( "-sessions" '' '' ); n=$((n+1))
    i=0; over=0
    while IFS= read -r name; do
      i=$((i+1)); n=$((n+1))
      if [ "$n" -ge "$cap" ]; then over=1; break; fi
      # The bullet is a FORMAT, not baked in: one staged command serves clients
      # sitting on different sessions, because tmux expands it per client.
      args+=( "${i}: $(esc "$name")#{?#{==:#{session_name},$(esc "$name")},  •,}" \
              "$(mkey "$i")" \
              "run-shell \"$SELF jump $i '#{client_name}'\"" )
    done <<EOF
$(sessions)
EOF
    [ "$over" -eq 1 ] && args+=( "all sessions…" s "run-shell \"$SELF click picker '#{client_name}'\"" )
    # The row-0 buttons, reachable without a mouse. Plenty of phone SSH clients
    # never send mouse events at all, and below tmux 3.4 nothing on the status
    # bar is clickable on any client -- so every button has a keyboard path.
    # The explode label is a FORMAT, like the session bullet above: one staged
    # command serves every client, and tmux expands it per client at draw time,
    # so a client sitting on an exploded window reads "collapse panes" while one
    # on an ordinary window reads "explode panes".
    args+=( '' \
            "new window"  c "run-shell \"$SELF newwin '#{client_name}'\"" \
            "split right" h "run-shell \"$SELF split lr '#{client_name}'\"" \
            "split down"  v "run-shell \"$SELF split tb '#{client_name}'\"" \
            "#{?#{==:#{@agent_burst_of},},explode panes,collapse panes}" e \
              "run-shell \"$SELF burst-toggle '#{client_name}'\"" )
    args+=( '' "new project…" p "run-shell \"$SELF click picker '#{client_name}'\"" )

    case "$mode" in
      menu-args) printf '%s\n' "${args[@]}"; exit 0 ;;
      menu-cmd)
        # ONE line, always: this is stored in a tmux option and read back by
        # `run-shell -C`, and both are line-oriented.
        # -O keeps the menu open when the release half of the opening tap
        # arrives; `--` is load-bearing because the first item is a disabled
        # header whose name starts with '-', which tmux would parse as a flag.
        out="display-menu -O -x 0 -y S -T $(q "#[align=centre] ${MENU_LABEL} ") --"
        for a in "${args[@]}"; do out="$out $(q "$a")"; done
        printf '%s' "${out//$'\n'/ }"; printf '\n'; exit 0 ;;
    esac
    # Keyboard path. `--` is load-bearing: the first item is a disabled section
    # header whose name starts with '-', and without a terminator tmux parses it
    # as a flag and dies with "unknown flag -n".
    tmux display-menu ${client:+-c "$client"} -x 0 -y S \
      -T "#[align=centre] ${MENU_LABEL} " -- "${args[@]}"
    exit 0
    ;;
  focus)
    pane="${2:-}"; client="${3:-}"
    [ -n "$pane" ] || exit 0
    sess="$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null)" || exit 0
    win="$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null)"
    [ -n "$sess" ] || exit 0
    tmux switch-client ${client:+-c "$client"} -t "=$sess" 2>/dev/null
    tmux select-window -t "$win" 2>/dev/null
    tmux select-pane -t "$pane" 2>/dev/null
    exit 0
    ;;
  refresh)
    # refresh-client -S with no -t refreshes ONE client (tmux's "current" one),
    # so on a phone+laptop pair the other terminal keeps a stale rail until the
    # status interval. Refresh every attached client explicitly.
    while IFS= read -r c; do
      [ -n "$c" ] && tmux refresh-client -S -t "$c" 2>/dev/null
    done <<EOF
$(tmux list-clients -F '#{client_name}' 2>/dev/null)
EOF
    exit 0
    ;;
  route)
    route_of "${2:-}"; printf '\n'; exit 0
    ;;
  click)
    range="${2:-}"; client="${3:-}"; mx="${4:-}"; my="${5:-}"
    # shellcheck disable=SC2046 -- route_of returns at most "jump N"
    set -- $(route_of "$range")
    case "${1:-none}" in
      jump)   exec "$0" jump "$2" "$client" ;;
      newwin) exec "$0" newwin "$client" ;;
      split)  exec "$0" split "$2" "$client" ;;
      menu)   exec "$0" menu "$client" ;;
      picker)
        # -c is what makes this work from run-shell, which carries no client of
        # its own; without it tmux picks its "best" client and the popup can open
        # on somebody else's terminal.
        pk="$(tmux show-option -gqv @agent_tmux_picker 2>/dev/null)"
        [ -n "$pk" ] || pk="$(cd "$(dirname "$0")" && pwd)/tmux-sessionizer"
        # Backgrounded: display-popup blocks until dismissed, and run-shell
        # without -b holds tmux's command queue the whole time.
        ( tmux display-popup ${client:+-c "$client"} -E "$pk" >/dev/null 2>&1 & ) ;
        ;;
    esac
    exit 0
    ;;
  *)
    echo "usage: tmux-sessions status [current] [width] | jump N [client] |" >&2
    echo "       newwin [client] | split lr|tb [client] |" >&2
    echo "       burst [client] | gather [client] | burst-toggle [client] |" >&2
    echo "       click RANGE [client] [x] [y] | route RANGE | menu[-args] CLIENT" >&2
    exit 2
    ;;
esac
